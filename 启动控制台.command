#!/bin/bash

# ===================================================
# 📍 1. 锚定坐标系：强制把运行目录锁定在项目根目录
# ===================================================
cd "$(dirname "$0")"

# ===================================================
# 🐍 2. 注入隔离环境：优先激活 venv
# ===================================================
if [ -f "./venv/bin/activate" ]; then
    source venv/bin/activate
    echo "🌐 已进入隔离环境 (venv)"
else
    echo "⚠️ 警报：未发现 venv，正在使用系统全局 Python 环境"
fi

# ===================================================
# 🛡️ 3. 极简守护循环：支持崩溃秒重启
# ===================================================
while true; do
    clear
    echo "========================================================"
    echo " 🌟 欢迎使用 AutoAI 中枢系统控制台 "
    echo " 💡 提示：在运行中按【Ctrl+C】可停止当前服务"
    echo " 🛡️ 状态：控制台已与浏览器进程解耦，引擎将自动接管 Chrome"
    echo "========================================================"
    
    # 🎯 核心修复：把当前根目录强行加入 Python 的环境变量中
    # 防止 Uvicorn 变成“瞎子”找不到 core 文件夹
    export PYTHONPATH="$(pwd):$PYTHONPATH"
    
    # 启动最高统帅
    python3 main.py
    
    # 当 main.py 正常退出，或者你按了 Ctrl+C 强杀后，代码会走到这里
    echo ""
    echo "🛑 后端服务已退出或崩溃。"
    
    # 阻断器：按回车继续循环，按 Ctrl+C 彻底关闭终端窗口
    read -p "👉 按【回车键】立即重启，或按【Ctrl+C】彻底退出控制台..."
done
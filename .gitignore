# config.json

# ================= 运行时产物 =================
Downloads/
logs/
*.log
history.db
*.db
queue_backup.json

# ================= 垫图资源 =================
assets/references/

# ================= 工具配置（可能含 cookie/路径）=================
tools/*.json
tools/工具/*.json

# ================= 临时/缓存 =================
.DS_Store
Thumbs.db
*.tmp
*.bak
*.swp

# ================= AI 协作数据（工作记忆/会话，勿上传）=================
.codebuddy/

# ================= 操作系统 =================
Desktop.ini

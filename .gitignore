# ================= 虚拟环境 =================
venv/
env/
.venv/
__pycache__/
*.py[cod]
*$py.class

# ================= 浏览器 profile（含登录态/Cookie，绝不上传）=================
google_chrome_profile/
chrome_debug_profile/
chrome_profile/
*_profile/

# ================= 敏感配置 =================
